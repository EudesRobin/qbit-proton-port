#!/bin/sh
# Checks the commit message: prefix, length, no AI attribution (AGENTS.md, Git).
# Enable once per clone: git config core.hooksPath .githooks
command -v pwsh >/dev/null 2>&1 || { echo "commit-msg: pwsh not found, check skipped" >&2; exit 0; }
exec pwsh -NoProfile -File harness/Test-CommitMessage.ps1 "$1"
