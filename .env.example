# Copy to .env (not versioned) and fill in.

# qBittorrent WebUI port, as set in Options > Web UI (IP address 127.0.0.1).
# Pick your own port, not the default 8080 (e.g. any free port between 20000 and 40000).
QBIT_API_PORT=

# SHA-256 fingerprint of the WebUI HTTPS certificate. Filled in by: Sync-QbitProtonPort.ps1 -NewCertificate
QBIT_CERT_SHA256=

QBIT_PATH=C:\Program Files\qBittorrent\qbittorrent.exe

# Proton VPN network adapter name, as shown by Get-NetAdapter while connected.
VPN_INTERFACE=ProtonVPN
